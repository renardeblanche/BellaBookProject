\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bellabook}[2026/09/15 BellaBook house style]
\RequirePackage{geometry}
\geometry{paperwidth=176mm,paperheight=250mm,inner=20mm,outer=22mm,top=22mm,bottom=18mm,headheight=24pt,headsep=7mm,footskip=10mm}
\RequirePackage{xcolor}
\definecolor{BellaBlue}{HTML}{163A5F}
\definecolor{BellaLightBlue}{HTML}{EAF2F8}
\definecolor{BellaGray}{HTML}{5E6872}
\RequirePackage{fontspec}
\RequirePackage{amsmath,mathtools}
\RequirePackage{unicode-math}
\defaultfontfeatures{Ligatures=TeX}
\setmainfont{STIX}
\setsansfont{Noto Sans CJK SC}
\setmonofont{Noto Sans Mono CJK SC}
\setmathfont{STIX Math}
\setCJKmainfont{Noto Serif CJK SC}
\setCJKsansfont{Noto Sans CJK SC}
\setCJKmonofont{Noto Sans Mono CJK SC}
\RequirePackage{setspace}
\setstretch{1.18}
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{calc,decorations.pathmorphing,patterns}
\tikzset{
  bella figure/.style={
    every node/.append style={font=\small,fill=white,fill opacity=.94,text opacity=1,inner sep=1.1pt,outer sep=1.2pt}
  }
}
\RequirePackage{booktabs,longtable,array,tabularx}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=BellaBlue,urlcolor=BellaBlue,citecolor=BellaBlue,pdfborder={0 0 0},bookmarksnumbered=true,bookmarksopen=true}
\RequirePackage[most]{tcolorbox}
\RequirePackage{etoolbox}
\RequirePackage{caption}
\captionsetup{font=small,labelfont=bf,labelsep=space}

\titleformat{\chapter}[display]
  {\sffamily\bfseries\color{BellaBlue}}
  {\fontsize{13}{15}\selectfont 第\,\thechapter\,章}
  {4pt}
  {\fontsize{25}{30}\selectfont}
  [\vspace{5pt}\color{BellaBlue}\titlerule]
\titlespacing*{\chapter}{0pt}{-8pt}{24pt}
\titleformat{\section}{\sffamily\bfseries\color{BellaBlue}\fontsize{15}{19}\selectfont}{\S\,\thesection}{0.8em}{}
\titleformat{\subsection}{\sffamily\bfseries\color{BellaBlue}\fontsize{12}{15}\selectfont}{\thesubsection}{0.7em}{}

\newtcolorbox{bellabox}[1][]{enhanced,breakable,colback=BellaLightBlue,colframe=BellaBlue,boxrule=0pt,leftrule=2.5pt,arc=0mm,left=8pt,right=8pt,top=6pt,bottom=6pt,#1}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{BellaBlue}\leaders\hrule height \headrulewidth\hfill}}
\fancyhead[LE]{\small\sffamily\color{BellaGray}\leftmark}
\fancyhead[RO]{\small\sffamily\color{BellaGray}\rightmark}
\fancyfoot[LE,RO]{\small\color{BellaGray}\thepage}
\fancyfoot[LO,RE]{\scriptsize\sffamily\color{BellaGray}BellaBook}
\renewcommand{\chaptermark}[1]{\markboth{第\thechapter 章\quad #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\quad #1}}

\makeatletter
\renewcommand\footnoterule{\kern-3pt\color{BellaBlue}\hrule width .25\columnwidth height .4pt\kern 2.6pt\color{black}}
\makeatother
\newcommand{\jiaokan}[1]{\footnote{\textbf{校勘：}#1}}
\newcommand{\origpage}[1]{\marginpar{\raggedleft\scriptsize\color{BellaGray}原页\,#1}}
